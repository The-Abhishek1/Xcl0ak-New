generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Exploits ──────────────────────────────────────────────────────────────────

model Exploit {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  code         String?
  language     String        @default("other")
  type         String
  os           String[]
  cveId        String?
  authorAlias  String
  upvotes      Int           @default(0)
  downvotes    Int           @default(0)
  score        Float         @default(0)
  tags         String[]
  difficulty   String        @default("intermediate")
  verified     Boolean       @default(false)
  views        Int           @default(0)
  dnaRisk      Float?
  dnaPayload   String?
  fileUrl      String?
  status       String        @default("pending")
  reviewNote   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  votes        ExploitVote[]
  comments     Comment[]

  @@index([status])
  @@index([score(sort: Desc)])
  @@index([type])
  @@index([cveId])
}

model ExploitVote {
  id        String  @id @default(cuid())
  exploitId String
  userAlias String
  direction String
  exploit   Exploit @relation(fields: [exploitId], references: [id], onDelete: Cascade)

  @@unique([exploitId, userAlias])
}

model Comment {
  id          String    @id @default(cuid())
  exploitId   String
  parentId    String?
  authorAlias String
  body        String
  upvotes     Int       @default(0)
  createdAt   DateTime  @default(now())
  exploit     Exploit   @relation(fields: [exploitId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("Replies", fields: [parentId], references: [id])
  replies     Comment[] @relation("Replies")
}

// ── CVE & Threat Intelligence ─────────────────────────────────────────────────

model CVECache {
  id               String   @id @default(cuid())
  cveId            String   @unique
  description      String
  cvssScore        Float
  cvssVector       String?
  severity         String
  vendor           String?
  product          String?
  affectedVersions String[]
  patchAvailable   Boolean  @default(false)
  exploitableNow   Boolean  @default(false)
  publishedAt      DateTime
  modifiedAt       DateTime
  syncedAt         DateTime @default(now())

  @@index([severity])
  @@index([cvssScore(sort: Desc)])
}

model ThreatEvent {
  id         String   @id @default(cuid())
  type       String
  srcCountry String
  dstCountry String
  srcLat     Float
  srcLng     Float
  dstLat     Float
  dstLng     Float
  severity   Int
  details    String?
  sourceUrl  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  url         String   @unique
  source      String
  category    String
  country     String?
  summary     String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([publishedAt(sort: Desc)])
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  alias      String   @unique
  fp         String   @unique
  reputation Int      @default(0)
  badges     String[]
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  alias        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// ── CTF ───────────────────────────────────────────────────────────────────────

model CTFChallenge {
  id          String     @id @default(cuid())
  title       String
  category    String
  difficulty  String     @default("medium")
  description String
  flagHash    String
  points      Int
  fileUrl     String?
  hints       String[]
  expiresAt   DateTime?
  status      String     @default("pending")
  authorAlias String     @default("anonymous")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime   @default(now())
  solves      CTFSolve[]

  @@index([status])
}

model CTFSolve {
  id          String       @id @default(cuid())
  challengeId String
  userAlias   String
  solvedAt    DateTime     @default(now())
  challenge   CTFChallenge @relation(fields: [challengeId], references: [id])

  @@unique([challengeId, userAlias])
}

// ── Chat ──────────────────────────────────────────────────────────────────────

model ChatMessage {
  id        String   @id @default(cuid())
  room      String
  alias     String
  tier      String   @default("free")
  content   String
  type      String   @default("message")
  createdAt DateTime @default(now())

  @@index([room, createdAt(sort: Desc)])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userAlias String
  type      String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userAlias, createdAt(sort: Desc)])
  @@index([userAlias, read])
}

// ── Learning ──────────────────────────────────────────────────────────────────

model LearningPath {
  id          String          @id @default(cuid())
  title       String
  description String
  category    String          @default("web")
  difficulty  String          @default("beginner")
  authorAlias String
  status      String          @default("pending")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  upvotes     Int             @default(0)
  views       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  modules     LearnModule[]
  enrollments LearnEnroll[]

  @@index([status])
  @@index([category])
}

model LearnModule {
  id          String            @id @default(cuid())
  pathId      String
  order       Int
  title       String
  type        String            @default("read")
  content     String            @default("")
  xpReward    Int               @default(10)
  path        LearningPath      @relation(fields: [pathId], references: [id], onDelete: Cascade)
  completions LearnCompletion[]

  @@index([pathId])
}

model LearnEnroll {
  id         String       @id @default(cuid())
  pathId     String
  alias      String
  enrolledAt DateTime     @default(now())
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([pathId, alias])
}

model LearnCompletion {
  id          String      @id @default(cuid())
  moduleId    String
  alias       String
  completedAt DateTime    @default(now())
  module      LearnModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, alias])
}

// ── GitHub SAST Integration ───────────────────────────────────────────────────

model GitHubConnection {
  id            String       @id @default(cuid())
  userAlias     String       @unique
  githubUserId  String       @unique
  githubLogin   String
  accessToken   String
  avatarUrl     String?
  webhookSecret String       @default("")
  installedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  repos         GitHubRepo[]

  @@index([userAlias])
}

model GitHubRepo {
  id            String           @id @default(cuid())
  connectionId  String
  repoId        String
  fullName      String
  defaultBranch String           @default("main")
  private       Boolean          @default(false)
  language      String?
  webhookId     String?
  scanEnabled   Boolean          @default(true)
  lastScannedAt DateTime?
  connection    GitHubConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scans         RepoScan[]

  @@unique([connectionId, repoId])
  @@index([connectionId])
}

model RepoScan {
  id          String     @id @default(cuid())
  repoId      String
  commitSha   String
  branch      String
  prNumber    Int?
  status      String     @default("queued")
  findings    Int        @default(0)
  criticals   Int        @default(0)
  highs       Int        @default(0)
  result      Json?
  error       String?
  triggeredBy String     @default("webhook")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  repo        GitHubRepo @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt(sort: Desc)])
  @@index([status])
}

// ── AI Prompt Injection Scanner ───────────────────────────────────────────────

model AiScan {
  id           String    @id @default(cuid())
  userAlias    String
  targetUrl    String
  model        String
  systemPrompt String?
  categories   String[]  @default([])
  maxPrompts   Int       @default(50)
  status       String    @default("queued")
  findings     Int       @default(0)
  criticals    Int       @default(0)
  highs        Int       @default(0)
  result       Json?
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([userAlias, createdAt(sort: Desc)])
  @@index([status])
}

// ── Continuous Attack Surface Monitoring (CASM) ───────────────────────────────

model MonitoredAsset {
  id           String          @id @default(cuid())
  userAlias    String
  type         String
  target       String
  label        String?
  scanInterval Int             @default(24)
  lastScannedAt DateTime?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  snapshots    AssetSnapshot[]
  changes      AssetChange[]

  @@unique([userAlias, target])
  @@index([userAlias])
  @@index([isActive, lastScannedAt])
}

model AssetSnapshot {
  id         String         @id @default(cuid())
  assetId    String
  takenAt    DateTime       @default(now())
  subdomains String[]       @default([])
  openPorts  Json?
  techs      Json?
  cves       Json?
  sslExpiry  DateTime?
  httpStatus Int?
  dnsRecords Json?
  asset      MonitoredAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, takenAt(sort: Desc)])
}

model AssetChange {
  id           String         @id @default(cuid())
  assetId      String
  detectedAt   DateTime       @default(now())
  changeType   String
  severity     String         @default("medium")
  oldValue     String?
  newValue     String?
  description  String
  acknowledged Boolean        @default(false)
  asset        MonitoredAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, detectedAt(sort: Desc)])
  @@index([acknowledged])
}


// Add these models to the BOTTOM of your prisma/schema.prisma

model CloudAccount {
  id              String         @id @default(cuid())
  userAlias       String
  provider        String         // "aws" | "gcp" | "azure"
  accountId       String         // AWS account ID / GCP project ID / Azure subscription ID
  label           String?
  // AWS: role ARN for assume-role. GCP/Azure: encrypted credentials
  credentials     String         // AES-256 encrypted JSON blob
  region          String         @default("us-east-1")
  lastAuditAt     DateTime?
  postureScore    Int?           // 0-100
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  findings        CloudFinding[]

  @@unique([userAlias, provider, accountId])
  @@index([userAlias])
}

model CloudFinding {
  id           String       @id @default(cuid())
  accountId    String
  provider     String
  service      String       // "s3" | "ec2" | "iam" | "rds" | "vpc" etc
  resource     String       // resource ARN or ID
  ruleId       String       // e.g. "aws-s3-public-access"
  title        String
  description  String
  severity     String       // critical | high | medium | low
  status       String       @default("open") // open | suppressed | resolved
  remediation  String?
  compliance   String[]     @default([]) // ["CIS-1.1", "SOC2-CC6.1"]
  detectedAt   DateTime     @default(now())
  resolvedAt   DateTime?
  account      CloudAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, severity])
  @@index([accountId, service])
  @@index([status])
}

model DarkWebMonitor {
  id            String             @id @default(cuid())
  userAlias     String
  identifier    String             // email address or domain name
  type          String             // "email" | "domain"
  status        String             @default("pending") // pending | active | error
  hibpKey       String?            // encrypted HIBP API key
  intelxKey     String?            // encrypted IntelX API key
  lastCheckedAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  exposures     DarkWebExposure[]

  @@unique([userAlias, identifier])
  @@index([userAlias])
}

model DarkWebExposure {
  id           String          @id @default(cuid())
  monitorId    String
  source       String          // "HaveIBeenPwned" | "Intelligence X" | "pastebin.com" | ...
  identifier   String          // the actual email/domain that was found
  type         String          // "email" | "domain" | "api_key" | "credential"
  severity     String          // critical | high | medium | low
  title        String
  description  String
  dataTypes    String[]        @default([])
  url          String          @default("")
  breachDate   String?
  pwnCount     Int?
  acknowledged Boolean         @default(false)
  foundAt      DateTime        @default(now())
  monitor      DarkWebMonitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, severity])
  @@index([monitorId, foundAt(sort: Desc)])
  @@index([acknowledged])
}
